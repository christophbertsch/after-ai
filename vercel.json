{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "apps/frontend/after-ai-cmo-main/.next",
  "framework": "nextjs",
  "builds": [
    {
      "src": "apps/frontend/after-ai-cmo-main/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/frontend/after-ai-cmo-main/$1"
    }
  ]
}
